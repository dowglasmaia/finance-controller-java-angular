PORT=8080
# Logs: JSON (ecs|logstash|gelf) in every profile except local, which prints plain text.
LOG_FORMAT=ecs
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
APP_ENV=production
# Database (PostgreSQL). Development values only; set real secrets outside the repository.
# compose.yml reads POSTGRES_* and publishes the database on 127.0.0.1:DB_PORT.
POSTGRES_DB=finance_controller
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me-dev-only
DB_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/finance_controller
SPRING_DATASOURCE_USERNAME=finance
SPRING_DATASOURCE_PASSWORD=change-me-dev-only
# Observability (Spring Boot native OpenTelemetry). Export is off until enabled:
TRACING_SAMPLING_PROBABILITY=0.1
OTEL_EXPORT_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Set only when running with the ai profile:
OPENAI_API_KEY=
# Identity: JWT signing secret (HS256), at least 32 bytes. This is a FICTITIOUS development value, NOT for production:
# generate your own (e.g. `openssl rand -base64 48`) and keep it out of Git. Startup fails when missing or short.
APP_JWT_SECRET=dev-only-not-a-secret-change-me-0123456789abcdef
# Explicit frontend origin(s), comma-separated; no wildcard.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
