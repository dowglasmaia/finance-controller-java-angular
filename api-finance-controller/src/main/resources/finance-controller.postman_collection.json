    {
      "name": "Transactions",
      "item": [
        {
          "name": "listTransactions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test('tem totais', () => pm.expect(page.totals.balance).to.be.a('string'));",
                  "if (page.items.length) { pm.collectionVariables.set('transactionId', page.items[0].id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/transactions?month=2026-10&currency=BRL&type=ALL&page=1&size=15",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiPath}}",
                "transactions"
              ],
              "query": [
                {
                  "key": "month",
                  "value": "2026-10"
                },
                {
                  "key": "currency",
                  "value": "BRL"
                },
                {
                  "key": "type",
                  "value": "ALL"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "15"
                }
              ]
            },
            "description": "200 com `items`, `page`, `size`, `totalItems`, `totalPages` e `totals` (entradas, saídas e saldo do conjunto filtrado inteiro). `month` (YYYY-MM) e `currency` obrigatórios; `type` ALL|INCOME|EXPENSE; `page` a partir de 1 (padrão 1); `size` 1..100 (padrão 15). 400 parâmetro inválido."
          },
          "response": []
        },
