# Copie para .env (ignorado pelo Git). Valores FICTÍCIOS de desenvolvimento; nunca use em produção.
# Lido pelo compose.yml e pelos scripts em scripts/.

# Banco (PostgreSQL)
POSTGRES_DB=finance_controller
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me-dev-only
DB_PORT=5432

# Backend
# Segredo de assinatura do JWT (HS256), no mínimo 32 bytes. Gere o seu: openssl rand -base64 48
APP_JWT_SECRET=dev-only-not-a-secret-change-me-0123456789abcdef
SPRING_PROFILES_ACTIVE=local
API_PORT=8080
# Origem(ns) do frontend em desenvolvimento (separadas por vírgula; sem curinga). Só necessário sem proxy.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Frontend em contentor (o servidor de desenvolvimento 'npm start' usa sempre a porta 4200)
WEB_PORT=8081

# E-mail (recuperação de senha). Em desenvolvimento, o Mailpit do compose captura tudo: abra http://localhost:8025.
# Com a API fora do contentor (mvnw spring-boot:run), o SMTP é localhost:1025.
FC_MAIL_HOST=localhost
FC_MAIL_PORT=1025
FC_MAIL_USERNAME=
FC_MAIL_PASSWORD=
FC_MAIL_FROM=no-reply@finance-controller.local
# Endereço do frontend usado no link do e-mail (nunca vem do pedido). Fora do desenvolvimento precisa ser HTTPS.
FC_APP_BASE_URL=http://localhost:4200
# Validade do link de recuperação
FC_PASSWORD_RESET_TTL=30m

# Tag das imagens Docker (api e web). Use uma versão ou o SHA do commit; evite `latest` para poder reverter.
FC_IMAGE_TAG=dev
